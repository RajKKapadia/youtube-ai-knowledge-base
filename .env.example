APP_NAME=YouTube AI Knowledge Base

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/youtube_kb
REDIS_URL=redis://localhost:6379/0

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=youtube_video_chunks

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Leave empty for automatic language detection.
WHISPER_LANGUAGE=

CHUNK_SIZE_SEGMENTS=10
CHUNK_OVERLAP_SEGMENTS=2

DATA_DIR=/tmp/youtube-ai-knowledge-base/videos
MODEL_CACHE_DIR=/tmp/youtube-ai-knowledge-base/models

# YouTube increasingly requires Proof-of-Origin tokens for media downloads.
# Run the BgUtils provider on this URL; Docker Compose starts it automatically.
YOUTUBE_PLAYER_CLIENT=mweb
YOUTUBE_POT_PROVIDER_URL=http://127.0.0.1:4416
YOUTUBE_FORMAT=best[acodec!=none][vcodec!=none][height<=360]/bestaudio/best
YOUTUBE_DOWNLOAD_RETRIES=3

# Optional. Search works fully locally without this.
# Required only for POST /videos/{video_id}/chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
